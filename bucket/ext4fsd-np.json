{
    "version": "0.71",
    "description": "Ext4 file system driver for Windows.",
    "homepage": "https://github.com/bobranten/Ext4Fsd",
    "license": {
        "identifier": "GPL-2.0-or-later",
        "url": "https://github.com/bobranten/Ext4Fsd/blob/master/Ext4Fsd/COPYRIGHT.TXT"
    },
    "notes": "The driver installs to 'C:\\Program Files\\Ext2Fsd' and registers a kernel driver and service; admin rights are required. Windows may show a 'installation failed' dialog during install (due to driver signing) and a confirmation dialog on uninstall - both can be dismissed, the install succeeds anyway.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/bobranten/Ext4Fsd/releases/download/v0.71/Ext2Fsd-0.71-setup.exe",
            "hash": "3c127f8e70c6b056a0185850efb71b9c45d2ff493b7df6b7b648eb89ec84214d"
        }
    },
    "installer": {
        "script": [
            "if (!(is_admin)) { error \"$app requires admin rights to $cmd\"; break }",
            "Invoke-ExternalCommand \"$dir\\$fname\" -ArgumentList @('/S') | Out-Null",
            "Remove-Item \"$dir\\$fname\""
        ]
    },
    "uninstaller": {
        "script": [
            "if (!(is_admin)) { error \"$app requires admin rights to $cmd\"; break }",
            "Invoke-ExternalCommand \"$env:ProgramW6432\\Ext2Fsd\\Uninstall.exe\" -ArgumentList @('/S') | Out-Null"
        ]
    },
    "checkver": {
        "github": "https://github.com/bobranten/Ext4Fsd"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bobranten/Ext4Fsd/releases/download/v$version/Ext2Fsd-$version-setup.exe"
            }
        }
    }
}
