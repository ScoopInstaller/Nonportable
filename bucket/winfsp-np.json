{
    "version": "2.2.26323",
    "description": "Set of software components that allows the creation of user mode file systems.",
    "homepage": "https://winfsp.dev/",
    "license": "GPL-3.0-only",
    "url": "https://github.com/winfsp/winfsp/releases/download/v2.2/winfsp-2.2.26323.msi#/setup.msi_",
    "hash": "36ce01f9eedbbe6842b7fb4bedc79d7d4f71983e8aceb6877b46a07b331c7e19",
    "installer": {
        "script": [
            "if (!(is_admin)) { error \"$app requires admin rights to $cmd\"; break }",
            "$succ = Invoke-ExternalCommand msiexec -ArgumentList @('/i', \"$dir\\setup.msi_\", 'ADDLOCAL=F.Developer', '/qn')",
            "if(-not $succ) { break }"
        ]
    },
    "uninstaller": {
        "script": [
            "if (!(is_admin)) { error \"$app requires admin rights to $cmd\"; break }",
            "$succ = Invoke-ExternalCommand msiexec -ArgumentList @('/x', \"$dir\\setup.msi_\", '/qn')",
            "if(-not $succ) { break }"
        ]
    },
    "checkver": {
        "github": "https://api.github.com/repos/winfsp/winfsp/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "winfsp-(\\d+\\.\\d+\\.\\d+)\\.msi"
    },
    "autoupdate": {
        "url": "https://github.com/winfsp/winfsp/releases/download/v$majorVersion.$minorVersion/winfsp-$version.msi#/setup.msi_"
    }
}
